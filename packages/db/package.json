{
  "name": "@choose/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "typecheck": "tsc --noEmit",
    "check-migrations": "tsx --env-file-if-exists=../../.env src/check-migrations.ts",
    "purge-cdn": "tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.prod src/purge-cdn.ts",
    "migrate:prod": "CONFIRM_PROD=1 DB_ENV=prod drizzle-kit migrate",
    "seed:prod": "CONFIRM_PROD=1 tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.prod src/seed.ts",
    "site-role": "tsx --env-file-if-exists=../../.env src/site-role.ts",
    "site-role:prod": "CONFIRM_PROD=1 tsx --env-file-if-exists=../../.env --env-file-if-exists=../../.env.prod src/site-role.ts"
  },
  "dependencies": {
    "@choose/catalog": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  }
}
