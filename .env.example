# La base sur laquelle on travaille : Postgres local (pnpm pg:local, ou infra/docker-compose.yml) ou une
# branche Neon de dev (`npx neon@latest checkout <branche>`, qui écrit ici DATABASE_URL, DATABASE_URL_UNPOOLED
# et NEON_BRANCH). pnpm dev, pnpm db:seed et pnpm db:migrate lisent ce fichier, et refusent d'écrire en
# production (packages/db/src/production.ts).
DATABASE_URL=postgres://choose:choose@localhost:54329/choose_a_device

# La production va dans .env.prod (ignoré par git), lu seulement par pnpm db:migrate:prod, db:seed:prod,
# db:site-role:prod et db:purge-cdn :
#   DATABASE_URL=…            (pooler Neon)
#   DATABASE_URL_UNPOOLED=…   (connexion directe : migrations et seed)
#   NEON_BRANCH=production
#   NETLIFY_AUTH_TOKEN=…      (jeton personnel Netlify : purge du CDN après un seed)
