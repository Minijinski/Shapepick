{
  "name": "choose-a-device",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@choose/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "pg:local": "sh scripts/pg-local.sh",
    "db:generate": "pnpm --filter @choose/db generate",
    "db:migrate": "pnpm --filter @choose/db migrate",
    "db:seed": "pnpm --filter @choose/db seed",
    "db:studio": "pnpm --filter @choose/db studio",
    "ingest": "pnpm --filter @choose/ingest ingest"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@netlify/vite-plugin-tanstack-start": "^1.3.19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "turbo": "^2.11.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
